# Auto-generated ROS graph from ros_graph_export
# generated_at: {{ generated_at }}
# nodes: {{ node_count }}, topics: {{ topic_count }}, edges: {{ edge_count }}

direction: right

vars: {
  d2-legend: {
    style.fill: "#f8f9ff"
    style.font-color: "#334155"
    style.border-radius: 8
    nodes: "Nodes: {{ node_count }}" {
      style.fill: "#1f77b4"
      style.font-color: white
      style.border-radius: 6
    }
    nodes -> nodes: "Topics: {{ edge_count }}" {
      style.stroke: "#17becf"
    }
  }
}

*.style.border-radius: 6

{%- if node_count == 0 %}
empty: "No active ROS nodes detected"
{%- else %}
{%- for container in containers %}
{{ container.identifier }}: "{{ container.label | replace('"', '\\"') }}" {
  style.fill: "#f0f4ff"
  style.font-color: "#1f77b4"
  style.border-radius: 8
}
{%- endfor %}

{%- for node in nodes %}
{{ node.identifier }}: "{{ node.label | replace('"', '\\"') }}" {
  {%- if node.is_dummy %}
  style.opacity: 0
  style.stroke-width: 0
  style.fill: transparent
  style.font-color: transparent
  {%- else %}
  style.fill: "#1f77b4"
  style.font-color: white
  style.border-radius: 6
  {%- endif %}
}
{%- endfor %}

{%- for edge in edges %}
{{ edge.source }} -> {{ edge.target }}: "{{ edge.label | replace('"', '\\"') }}" {
  {%- if edge.edge_type == "missing_subscribers" %}
  style.stroke: "#f97316"
  {%- elif edge.edge_type == "missing_publishers" %}
  style.stroke: "#ef4444"
  {%- else %}
  style.stroke: "#17becf"
  {%- endif %}
}
{%- endfor %}
{%- endif %}
